__pycache__/
*.pyc
*.pyo
.venv/
venv/
.env
*.egg-info/
build/
dist/
.pytest_cache/

# Runtime state — produced by the daemon, never committed
ipc/inbox/*
ipc/outbox/*
logs/
STATUS.json
*.lock

# Scratch files from one-shot scripts (do-commit.ps1 etc.)
*.tmp
__gitout.*
__giterr.*
commit-log.*

# Keep the ipc/ subdirs visible to the daemon at clone time
!ipc/inbox/.gitkeep
!ipc/outbox/.gitkeep
